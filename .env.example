# --- AI engine -------------------------------------------------------------
# Leave every key empty to run on the free offline rules engine.
#
# FREE: Groq. Get a key at https://console.groq.com/keys (no card needed).
# The same key also powers speech-to-text, so the mic works in any browser.
GROQ_API_KEY=
# Comma-separated: when one model hits its free rate limit, the next one answers
GROQ_MODEL=qwen/qwen3.8-27b,openai/gpt-oss-120b,openai/gpt-oss-20b
#
# FREE alternative: Google Gemini. Key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
#
# PAID: Anthropic Claude. Key at https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
#
# auto = first provider with a key (groq, then gemini, then claude) | groq | gemini | claude
LLM_PROVIDER=auto
# auto = use the LLM if a key is present, else rules | rules = always rules
AGENT_ENGINE=auto

# --- Voice -----------------------------------------------------------------
# Agent voice (free Microsoft Edge neural voices, no key needed)
TTS_VOICE_HI=hi-IN-SwaraNeural
TTS_VOICE_EN=en-IN-NeerjaNeural
# Speech-to-text model on Groq (used when GROQ_API_KEY is set)
STT_MODEL=whisper-large-v3-turbo

# --- Dashboard cost estimate (Claude only; Groq/Gemini free tiers count as 0)
LLM_PRICE_INPUT_PER_M=1.0
LLM_PRICE_OUTPUT_PER_M=5.0
USD_INR=84

# --- Login ------------------------------------------------------------------
# Set to 1 when the app is served over HTTPS so the session cookie is only sent securely
COOKIE_SECURE=0

# --- Calls
# Calls with no activity for this many minutes are closed automatically (same as a hang-up)
CALL_IDLE_TIMEOUT_MIN=10

# --- Call recordings pilot (app/recordings.py, uploader/)
# New recordings from the RMs' phones are transcribed and reviewed once a day at this time
RECORDINGS_DAILY_AT=21:00
RECORDINGS_TZ=Asia/Kolkata
# Whisper language for whole calls: hi (Hindi/Hinglish), en, or auto
RECORDINGS_LANG=hi
