<?xml version="1.0" encoding="utf-8"?>
<!-- Never back up or transfer the token, settings or upload ledger -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
