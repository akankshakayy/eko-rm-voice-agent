<?xml version="1.0" encoding="utf-8"?>
<!-- Android can't whitelist IP ranges here, so cleartext is technically permitted and the app itself
     refuses http:// to anything but a private LAN address (Matcher.serverUrlProblem). Production = https. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
